#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            bindings = <
            // Esc       1         2         3         4         5         6         7
               &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7
            // 8         9         0         -         =         Backspace Delete
               &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC  &kp DEL

            // Tab       Q         W         E         R         T         Y         U
               &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U
            // I         O         P         [         ]         \         PrintScreen
               &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH  &kp PSCRN

            // Caps      A         S         D         F         G         H         J
               &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J
            // K         L         ;         '         Enter     PageUp
               &kp K     &kp L     &kp SEMI  &kp SQT   &kp ENTER &kp PG_UP

            // LShift    Z         X         C         V         B         N         M
               &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M
            // ,         .         /         RShift    Up        PageDown
               &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP    &kp PG_DN

            // LCtrl     Win       LAlt      Space     RAlt      Fn        RCtrl
               &kp LCTRL &kp LGUI  &kp LALT  &kp SPACE &kp RALT  &mo 1     &kp RCTRL
            // Left      Down      Right
               &kp LEFT  &kp DOWN  &kp RIGHT

            // Encoder push
               &kp C_MUTE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            display-name = "Fn";

            bindings = <
            // Esc       F1        F2        F3        F4        F5        F6        F7
               &trans    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7
            // F8        F9        F10       F11       F12       Backspace Clear current BT bond
               &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &trans    &bt BT_CLR

            // Tab       BT 1          BT 2          BT 3          BT 4          BT 5
               &trans    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
            // Y         U         I         O         P         [         ]         \         PrintScreen
               &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans

            // Caps      A         S         D         F         G         H         J
               &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            // K         L         ;         '         Enter     PageUp
               &trans    &trans    &trans    &trans    &trans    &trans

            // LShift    Z         X         C         V         B         N         M
               &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            // ,         .         /         RShift    Up        PageDown
               &trans    &trans    &trans    &trans    &trans    &trans

            // LCtrl     Win       LAlt      Space     RAlt      Fn        RCtrl
               &trans    &trans    &trans    &trans    &trans    &trans    &trans
            // Left      Down      Right
               &trans    &trans    &trans

            // Fn + encoder push: unlock Studio
               &studio_unlock
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_layer_1 {
            status = "reserved";
        };

        extra_layer_2 {
            status = "reserved";
        };
    };
};