#include "custom_keyboard-layouts.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio1 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 2  GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio0 31 GPIO_ACTIVE_HIGH>
            , <&gpio1 13 GPIO_ACTIVE_HIGH>
            , <&gpio1 11 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            , <&gpio0 9  GPIO_ACTIVE_HIGH>
            ;
    };

    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        rows = <9>;
        columns = <8>;

        map = <
        // Esc       1         2         3         4         5         6         7
           RC(1,0)   RC(0,0)   RC(1,1)   RC(0,1)   RC(1,2)   RC(0,2)   RC(1,3)   RC(0,3)
        // 8         9         0         -         =         Backspace Delete
           RC(1,4)   RC(0,4)   RC(1,5)   RC(0,5)   RC(1,6)   RC(0,6)   RC(0,7)

        // Tab       Q         W         E         R         T         Y         U
           RC(3,0)   RC(2,0)   RC(3,1)   RC(2,1)   RC(3,2)   RC(2,2)   RC(3,3)   RC(2,3)
        // I         O         P         [         ]         \         PrintScreen
           RC(3,4)   RC(2,4)   RC(3,5)   RC(2,5)   RC(3,6)   RC(2,6)   RC(2,7)

        // Caps      A         S         D         F         G         H         J
           RC(5,0)   RC(4,0)   RC(5,1)   RC(4,1)   RC(5,2)   RC(4,2)   RC(5,3)   RC(4,3)
        // K         L         ;         '         Enter     PageUp
           RC(5,4)   RC(4,4)   RC(5,5)   RC(4,5)   RC(4,6)   RC(4,7)

        // LShift    Z         X         C         V         B         N         M
           RC(7,0)   RC(6,0)   RC(7,1)   RC(6,1)   RC(7,2)   RC(6,2)   RC(7,3)   RC(6,3)
        // ,         .         /         RShift    Up        PageDown
           RC(7,4)   RC(6,4)   RC(7,5)   RC(6,5)   RC(6,6)   RC(6,7)

        // LCtrl     Win       LAlt      Space     RAlt      Fn        RCtrl
           RC(8,0)   RC(8,1)   RC(8,2)   RC(8,3)   RC(8,4)   RC(8,5)   RC(8,6)
        // Left      Down      Right
           RC(7,6)   RC(8,7)   RC(7,7)

        // Encoder push button
           RC(1,7)
        >;
    };

    encoder0: encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <20>;
    };
};

&default_layout {
    kscan = <&kscan0>;
    transform = <&default_transform>;
};